
{
  "info": {
    "name": "ProjectFlow API Testing",
    "description": "API testing collection for the Advanced Project and Team Management System built with FastAPI and PostgreSQL.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "projectId",
      "value": "1"
    },
    {
      "key": "taskId",
      "value": "1"
    },
    {
      "key": "userId",
      "value": "2"
    }
  ],
  "item": [
    {
      "name": "01 - Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Test User\",\n  \"email\": \"testuser@example.com\",\n  \"password\": \"TestUser@2026\"\n}"
            },
            "url": "{{base_url}}/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    if (data.access_token) {",
                  "        pm.collectionVariables.set('token', data.access_token);",
                  "        console.log('JWT token saved successfully.');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"YOUR_ADMIN_EMAIL\",\n  \"password\": \"YOUR_ADMIN_PASSWORD\"\n}"
            },
            "url": "{{base_url}}/auth/login"
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "02 - User Management",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/users/"
          }
        },
        {
          "name": "Update User Role",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"Project Manager\"\n}"
            },
            "url": "{{base_url}}/users/{{userId}}/role"
          }
        },
        {
          "name": "Update User Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_active\": true\n}"
            },
            "url": "{{base_url}}/users/{{userId}}/status"
          }
        }
      ]
    },
    {
      "name": "03 - Project Management",
      "item": [
        {
          "name": "Create Project",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const data = pm.response.json();",
                  "    if (data.id) pm.collectionVariables.set('projectId', data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"ProjectFlow Demo Project\",\n  \"description\": \"Demonstration project for API testing\",\n  \"status\": \"Planning\",\n  \"start_date\": \"2026-11-18\",\n  \"deadline\": \"2026-12-15\"\n}"
            },
            "url": "{{base_url}}/projects/"
          }
        },
        {
          "name": "Get All Projects",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/projects/?page=1&limit=10"
          }
        },
        {
          "name": "Get Project By ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/projects/{{projectId}}"
          }
        },
        {
          "name": "Update Project",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated ProjectFlow Demo\",\n  \"description\": \"Updated project description\",\n  \"status\": \"In Progress\"\n}"
            },
            "url": "{{base_url}}/projects/{{projectId}}"
          }
        },
        {
          "name": "Delete Project",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/projects/{{projectId}}"
          }
        }
      ]
    },
    {
      "name": "04 - Project Members",
      "item": [
        {
          "name": "Add Project Member",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": 2\n}"
            },
            "url": "{{base_url}}/projects/{{projectId}}/members"
          }
        },
        {
          "name": "Get Project Members",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/projects/{{projectId}}/members"
          }
        },
        {
          "name": "Remove Project Member",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/projects/{{projectId}}/members/{{userId}}"
          }
        }
      ]
    },
    {
      "name": "05 - Task Management",
      "item": [
        {
          "name": "Create Task",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const data = pm.response.json();",
                  "    if (data.id) pm.collectionVariables.set('taskId', data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Develop ProjectFlow Dashboard\",\n  \"description\": \"Build and test the project dashboard\",\n  \"project_id\": 1,\n  \"assigned_to\": 2,\n  \"priority\": \"High\",\n  \"status\": \"To Do\",\n  \"due_date\": \"2026-12-10\"\n}"
            },
            "url": "{{base_url}}/tasks/"
          }
        },
        {
          "name": "Get All Tasks",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/tasks/?page=1&limit=10"
          }
        },
        {
          "name": "Get Tasks By Project",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/tasks/project/{{projectId}}"
          }
        },
        {
          "name": "Get Task By ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/tasks/{{taskId}}"
          }
        },
        {
          "name": "Update Task",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated ProjectFlow Dashboard\",\n  \"priority\": \"Critical\",\n  \"status\": \"In Progress\"\n}"
            },
            "url": "{{base_url}}/tasks/{{taskId}}"
          }
        },
        {
          "name": "Delete Task",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/tasks/{{taskId}}"
          }
        }
      ]
    },
    {
      "name": "06 - Comments",
      "item": [
        {
          "name": "Add Task Comment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"comment\": \"Task progress updated successfully.\"\n}"
            },
            "url": "{{base_url}}/comments/task/{{taskId}}"
          }
        },
        {
          "name": "Get Task Comments",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/comments/task/{{taskId}}"
          }
        }
      ]
    },
    {
      "name": "07 - Activity Logs",
      "item": [
        {
          "name": "Get All Activity Logs",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/activity-logs/"
          }
        },
        {
          "name": "Get Activity Logs By Project And Task",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/activity-logs/?project_id={{projectId}}&task_id={{taskId}}"
          }
        }
      ]
    }
  ]
}
